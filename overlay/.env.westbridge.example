# ---------------------------------------------------------------------------
# WestBridge additions — append these to the .env generated by Laravel.
# ---------------------------------------------------------------------------

APP_NAME="WestBridge Technologies"
APP_TIMEZONE=Africa/Juba
APP_URL=https://westbridgetech.example

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=westbridge
DB_USERNAME=westbridge
DB_PASSWORD=

# Commerce — pending decision D2 (transacting currency)
WB_CURRENCY=USD
WB_DISPLAY_CURRENCY=SSP

# Insights stays out of the navigation until six posts exist (decision D5)
WB_SHOW_INSIGHTS=false

# Redis is recommended once the server can run it; the database driver is a
# working fallback on a small VPS (see blueprint §08, Horizon note).
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# Use a transactional email provider — invoices sent from a self-hosted mail
# server frequently land in spam (blueprint, Risks).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
